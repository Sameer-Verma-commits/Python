import numpy as np
from scipy.stats import f_oneway

# Define three groups of data
group1 = np.array([10, 12, 14, 16, 18])
group2 = np.array([20, 22, 24, 26, 28])
group3 = np.array([30, 32, 34, 36, 38])

# Calculate mean of each group
print("Mean of Group 1:", np.mean(group1))
print("Mean of Group 2:", np.mean(group2))
print("Mean of Group 3:", np.mean(group3))

# Perform One-Way ANOVA test
f_value, p_value = f_oneway(group1, group2, group3)

# Display results
print("\nF-Value:", f_value)
print("P-Value:", p_value)

# Decision
if p_value < 0.05:
    print("Reject the Null Hypothesis")
else:
    print("Accept the Null Hypothesis")

